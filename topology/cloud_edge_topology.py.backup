
import os
import sys

from mininet.net import Mininet
from mininet.node import RemoteController, OVSSwitch
from mininet.cli import CLI
from mininet.log import setLogLevel, info
from mininet.link import TCLink


# ============================================================
# CHEMINS DU PROJET
# ============================================================

PROJECT_ROOT = os.path.dirname(
    os.path.dirname(os.path.abspath(__file__))
)

STRATEGIES_DIR = os.path.join(
    PROJECT_ROOT,
    "strategies"
)

if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

if STRATEGIES_DIR not in sys.path:
    sys.path.insert(0, STRATEGIES_DIR)


# ============================================================
# STRATEGIES
# ============================================================

from round_robin import DomainRoundRobin
from weighted_round_robin import DomainWeightedRoundRobin
from sdnct_rlml import DomainSDNCTRLML


# ============================================================
# CREATION DE LA TOPOLOGIE
# ============================================================

def create_topology():

    # --------------------------------------------------------
    # Strategie choisie par variable d'environnement
    # --------------------------------------------------------

    strategy = os.environ.get(
        "SDN_STRATEGY",
        "round_robin"
    )

    info("\n")
    info("====================================================\n")
    info(" STRATEGIE : %s\n" % strategy)
    info("====================================================\n")


    # --------------------------------------------------------
    # Creation du reseau Mininet
    # --------------------------------------------------------

    net = Mininet(
        controller=None,
        switch=OVSSwitch,
        link=TCLink,
        autoSetMacs=True
    )


    # ========================================================
    # CONTROLEURS
    # ========================================================

    if strategy == "onos_static":

        info("*** Mode ONOS mono-instance\n")

        onos = net.addController(
            "onos",
            controller=RemoteController,
            ip="127.0.0.1",
            port=6653
        )

        controllers = {
            "onos": onos
        }

    else:

        info("*** Mode multi-controleurs Ryu\n")

        ryu1 = net.addController(
            "ryu1",
            controller=RemoteController,
            ip="127.0.0.1",
            port=6653
        )

        ryu2 = net.addController(
            "ryu2",
            controller=RemoteController,
            ip="127.0.0.1",
            port=6654
        )

        ryu3 = net.addController(
            "ryu3",
            controller=RemoteController,
            ip="127.0.0.1",
            port=6655
        )

        ryu4 = net.addController(
            "ryu4",
            controller=RemoteController,
            ip="127.0.0.1",
            port=6656
        )

        controllers = {
            "ryu1": ryu1,
            "ryu2": ryu2,
            "ryu3": ryu3,
            "ryu4": ryu4
        }


    # ========================================================
    # SWITCHES
    # ========================================================

    s1 = net.addSwitch(
        "s1",
        protocols="OpenFlow13"
    )

    s2 = net.addSwitch(
        "s2",
        protocols="OpenFlow13"
    )

    s3 = net.addSwitch(
        "s3",
        protocols="OpenFlow13"
    )

    s4 = net.addSwitch(
        "s4",
        protocols="OpenFlow13"
    )

    s5 = net.addSwitch(
        "s5",
        protocols="OpenFlow13"
    )

    s6 = net.addSwitch(
        "s6",
        protocols="OpenFlow13"
    )


    # ========================================================
    # HOTES
    # ========================================================

    h1 = net.addHost("h1")
    h2 = net.addHost("h2")

    h3 = net.addHost("h3")
    h4 = net.addHost("h4")

    h5 = net.addHost("h5")
    h6 = net.addHost("h6")

    h7 = net.addHost("h7")
    h8 = net.addHost("h8")

    h9 = net.addHost("h9")
    h10 = net.addHost("h10")

    h11 = net.addHost("h11")
    h12 = net.addHost("h12")


    # ========================================================
    # LIENS HOTES -> SWITCHES
    # ========================================================

    # -------------------------
    # Domaine Edge 1
    # -------------------------

    net.addLink(
        h1,
        s1
    )

    net.addLink(
        h2,
        s1
    )

    net.addLink(
        h3,
        s2
    )

    net.addLink(
        h4,
        s2
    )

    net.addLink(
        h5,
        s3
    )

    net.addLink(
        h6,
        s3
    )


    # -------------------------
    # Domaine Edge 2
    # -------------------------

    net.addLink(
        h7,
        s4
    )

    net.addLink(
        h8,
        s4
    )

    net.addLink(
        h9,
        s5
    )

    net.addLink(
        h10,
        s5
    )

    net.addLink(
        h11,
        s6
    )

    net.addLink(
        h12,
        s6
    )


    # ========================================================
    # LIENS ENTRE SWITCHES
    # ========================================================

    info("*** Creation des liens Edge 1\n")

    net.addLink(
        s1,
        s2
    )

    net.addLink(
        s2,
        s3
    )


    info("*** Creation du lien inter-domaine\n")

    net.addLink(
        s3,
        s4
    )


    info("*** Creation des liens Edge 2\n")

    net.addLink(
        s4,
        s5
    )

    net.addLink(
        s5,
        s6
    )


    # ========================================================
    # CONSTRUCTION DU RESEAU
    # ========================================================

    info("*** Construction du reseau\n")

    net.build()


    # ========================================================
    # DEMARRAGE DES CONTROLEURS
    # ========================================================

    info("*** Demarrage des controleurs\n")

    if strategy == "onos_static":

        onos.start()

    else:

        ryu1.start()
        ryu2.start()
        ryu3.start()
        ryu4.start()


    # ========================================================
    # AFFECTATION DES SWITCHES
    # ========================================================

    if strategy == "onos_static":

        # ----------------------------------------------------
        # ONOS MONO-INSTANCE
        # Tous les switches sont geres par ONOS.
        # ----------------------------------------------------

        info("*** Affectation des switches a ONOS\n")

        s1.start([onos])
        s2.start([onos])
        s3.start([onos])
        s4.start([onos])
        s5.start([onos])
        s6.start([onos])


    else:

        # ----------------------------------------------------
        # Definition des domaines
        # ----------------------------------------------------

        domains = {
            "edge1": [
                "ryu1",
                "ryu2"
            ],
            "edge2": [
                "ryu3",
                "ryu4"
            ]
        }


        # ----------------------------------------------------
        # Round Robin
        # ----------------------------------------------------

        if strategy == "round_robin":

            scheduler = DomainRoundRobin(
                domains
            )

            info("*** Affectation Round Robin\n")

            assignment = {}

            for switch_name in ["s1", "s2", "s3"]:

                controller_name = scheduler.select_controller(
                    "edge1"
                )

                assignment[switch_name] = controller_name


            for switch_name in ["s4", "s5", "s6"]:

                controller_name = scheduler.select_controller(
                    "edge2"
                )

                assignment[switch_name] = controller_name


        # ----------------------------------------------------
        # Weighted Round Robin
        # ----------------------------------------------------

        elif strategy == "weighted_round_robin":

            weighted_domains = {

                "edge1": {
                    "ryu1": 1,
                    "ryu2": 2
                },

                "edge2": {
                    "ryu3": 1,
                    "ryu4": 2
                }

            }

            scheduler = DomainWeightedRoundRobin(
                weighted_domains
            )

            info("*** Affectation Weighted Round Robin\n")

            assignment = {}

            for switch_name in ["s1", "s2", "s3"]:

                controller_name = scheduler.select_controller(
                    "edge1"
                )

                assignment[switch_name] = controller_name


            for switch_name in ["s4", "s5", "s6"]:

                controller_name = scheduler.select_controller(
                    "edge2"
                )

                assignment[switch_name] = controller_name


               # ----------------------------------------------------
        # SDNCT-RLML-INSPIRED
        # ----------------------------------------------------

        elif strategy == "sdnct_rlml":

            initial_loads = {
                "ryu1": 20.0,
                "ryu2": 35.0,
                "ryu3": 15.0,
                "ryu4": 40.0
            }

            scheduler = DomainSDNCTRLML(
                domains,
                initial_loads
            )

            info("*** Affectation SDNCT-RLML-inspired\n")

            assignment = {}

            for switch_name in ["s1", "s2", "s3"]:

                controller_name = scheduler.select_controller(
                    "edge1"
                )

                assignment[switch_name] = controller_name

                current_load = scheduler.get_controller_loads(
                    "edge1"
                )[controller_name]

                scheduler.update_controller_load(
                    "edge1",
                    controller_name,
                    current_load + 1.0
                )


            for switch_name in ["s4", "s5", "s6"]:

                controller_name = scheduler.select_controller(
                    "edge2"
                )

                assignment[switch_name] = controller_name

                current_load = scheduler.get_controller_loads(
                    "edge2"
                )[controller_name]

                scheduler.update_controller_load(
                    "edge2",
                    controller_name,
                    current_load + 1.0
                )


        else:

            raise ValueError(
                "Strategie inconnue : %s" % strategy
            )


        # ====================================================
        # APPLICATION DE L'AFFECTATION
        # ====================================================

        info("\n")
        info("*** Affectation finale des switches\n")

        for switch_name, controller_name in assignment.items():

            info(
                "    %s -> %s\n"
                % (
                    switch_name,
                    controller_name
                )
            )


        # ----------------------------------------------------
        # Demarrage des switches avec leurs controleurs
        # ----------------------------------------------------

        for switch_name, controller_name in assignment.items():

            switch = net.get(
                switch_name
            )

            controller = controllers[
                controller_name
            ]

            switch.start(
                [controller]
            )


    # ========================================================
    # AFFICHAGE DE LA TOPOLOGIE
    # ========================================================

    info("\n")
    info("====================================================\n")
    info(" TOPOLOGIE CLOUD-EDGE\n")
    info("====================================================\n")

    info("Edge 1 : s1 - s2 - s3\n")
    info("Edge 2 : s4 - s5 - s6\n")
    info("Interconnexion : s3 - s4\n")

    info("\n")
    info("Hot es Edge 1 : h1 - h6\n")
    info("Hot es Edge 2 : h7 - h12\n")

    info("\n")


    # ========================================================
    # EXPERIMENTATION ONOS
    # ========================================================

    if (
        strategy == "onos_static"
        and os.environ.get("RUN_EXPERIMENT") == "onos_static"
    ):

        info("\n")
        info("====================================================\n")
        info(" LANCEMENT DE L'EXPERIMENTATION ONOS MONO-INSTANCE\n")
        info("====================================================\n")

        from monitoring.experiment_onos_static import run_all

        run_all(
            net,
            repetitions=10
        )

        info("\n")
        info("*** Experimentation ONOS terminee.\n")


    # ========================================================
    # CLI MININET
    # ========================================================

    info("\n")
    info("====================================================\n")
    info(" TOPOLOGIE PRETE\n")
    info("====================================================\n")
    info("*** Vous pouvez maintenant utiliser la CLI Mininet.\n")
    info("*** Exemple : pingall\n")
    info("*** Exemple : nodes\n")
    info("*** Exemple : net\n")
    info("*** Exemple : links\n")
    info("====================================================\n")

    CLI(net)


    # ========================================================
    # ARRET DU RESEAU
    # ========================================================

    info("\n")
    info("*** Arret du reseau...\n")

    net.stop()


# ============================================================
# PROGRAMME PRINCIPAL
# ============================================================

if __name__ == "__main__":

    setLogLevel("info")

    create_topology()
