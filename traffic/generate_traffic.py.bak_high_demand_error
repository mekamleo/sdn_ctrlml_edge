def ping_traffic(net, source, destination, count=20):
    """
    Génère du trafic ICMP entre deux hôtes Mininet.
    """

    src = net.get(source)
    dst = net.get(destination)

    print(f"[PING] {source} -> {destination}")

    result = src.cmd(
        f"ping -c {count} {dst.IP()}"
    )

    print(result)

    return result


def iperf_server(net, host, port=5001):
    """
    Démarre un serveur iperf sur un hôte.
    """

    node = net.get(host)

    print(
        f"[IPERF SERVER] Démarrage sur "
        f"{host}:{port}"
    )

    node.cmd(
        f"iperf -s -p {port} "
        f"> /tmp/iperf_{host}.log 2>&1 &"
    )


def iperf_traffic(
    net,
    source,
    destination,
    duration=20,
    bandwidth=None,
    port=5001
):
    """
    Génère un flux TCP avec iperf.
    """

    src = net.get(source)
    dst = net.get(destination)

    iperf_server(
        net,
        destination,
        port
    )

    time.sleep(1)

    command = (
        f"iperf -c {dst.IP()} "
        f"-p {port} "
        f"-t {duration}"
    )

    if bandwidth is not None:
        command += f" -b {bandwidth}"

    print(
        f"[IPERF] {source} -> {destination} "
        f"pendant {duration} secondes"
    )

    result = src.cmd(command)

    print(result)

    return result


def concurrent_traffic(net, flows):
    """
    Lance plusieurs flux simultanément.

    Format d'un flux :

    {
        "type": "ping" ou "iperf",
        "source": "h1",
        "destination": "h7",
        "duration": 20
    }
    """

    threads = []

    for flow in flows:

        if flow["type"] == "ping":

            thread = Thread(
                target=ping_traffic,
                args=(
                    net,
                    flow["source"],
                    flow["destination"],
                    flow.get("count", 20)
                )
            )

        elif flow["type"] == "iperf":

            thread = Thread(
                target=iperf_traffic,
                args=(
                    net,
                    flow["source"],
                    flow["destination"],
                    flow.get("duration", 20),
                    flow.get("bandwidth"),
                    flow.get("port", 5001)
                )
            )

        else:

            print(
                f"[WARNING] Type de trafic inconnu : "
                f"{flow['type']}"
            )

            continue

        threads.append(thread)
        thread.start()

    for thread in threads:
        thread.join()

    print(
        "[TRAFFIC] Tous les flux sont terminés"
    )


def run_flow_churn(
    net,
    duration=10,
    interval=0.05
):
    """
    Génère continuellement de nouveaux flux
    afin d'augmenter les événements Packet-In.
    """

    flows = [
        ("h1", "h2"),
        ("h1", "h3"),
        ("h1", "h4"),
        ("h1", "h5"),
        ("h1", "h6"),
        ("h2", "h5"),
        ("h2", "h6"),
        ("h2", "h7"),
        ("h2", "h8"),
        ("h3", "h7"),
        ("h3", "h8"),
        ("h3", "h9"),
        ("h3", "h10"),
        ("h4", "h9"),
        ("h4", "h10"),
        ("h4", "h11"),
        ("h4", "h12"),
        ("h5", "h11"),
        ("h5", "h12"),
        ("h6", "h7"),
        ("h6", "h8"),
        ("h7", "h9"),
        ("h7", "h10"),
        ("h8", "h11"),
        ("h8", "h12"),
        ("h9", "h11"),
        ("h9", "h12"),
        ("h10", "h1"),
        ("h10", "h2"),
        ("h11", "h3"),
        ("h11", "h4"),
        ("h12", "h5"),
        ("h12", "h6")
    ]

    print("\n========== FLOW CHURN ==========")
    print(f"Durée   : {duration} s")
    print(f"Intervalle : {interval} s")
    print(f"Débit théorique : {1 / interval:.1f} nouveaux flux/s")

    start_time = time.time()
    index = 0

    while time.time() - start_time < duration:

        source_name, destination_name = flows[
            index % len(flows)
        ]

        source = net.get(source_name)
        destination = net.get(destination_name)

        source.cmd(
            f"ping -c 1 -W 1 "
            f"{destination.IP()} "
            "> /dev/null 2>&1"
        )

        index += 1

        time.sleep(interval)

    elapsed = time.time() - start_time

    print(
        f"Flux générés : {index}"
    )
    print(
        f"Débit réel approximatif : "
        f"{index / elapsed:.1f} flux/s"
    )

    print("========== FIN FLOW CHURN ==========\n")


