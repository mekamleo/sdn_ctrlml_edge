def run_transient_overload(net):
    """
    Scénario C :
    surcharge transitoire du réseau Cloud-Edge.

    Phases :
      1. Charge normale
      2. Montée en charge
      3. Pic de surcharge
      4. Retour progressif
      5. Charge normale

    Le trafic est généré simultanément depuis plusieurs hôtes.
    """

    import threading
    import time

    print("\n")
    print("============================================================")
    print(" SCENARIO C - SURCHARGE TRANSITOIRE")
    print("============================================================")

    # Couples source/destination répartis sur les deux domaines
    flows = [
        ("h1", "h7"),
        ("h1", "h8"),
        ("h2", "h7"),
        ("h2", "h9"),
        ("h3", "h8"),
        ("h3", "h10"),
        ("h4", "h9"),
        ("h4", "h11"),
        ("h5", "h10"),
        ("h5", "h12"),
        ("h6", "h11"),
        ("h6", "h12"),

        ("h7", "h1"),
        ("h7", "h2"),
        ("h8", "h3"),
        ("h8", "h4"),
        ("h9", "h5"),
        ("h9", "h6"),
        ("h10", "h1"),
        ("h10", "h3"),
        ("h11", "h2"),
        ("h11", "h4"),
        ("h12", "h5"),
        ("h12", "h6"),
    ]

    def traffic_worker(source_name, destination_name, duration, interval):
        source = net.get(source_name)
        destination = net.get(destination_name)

        end_time = time.time() + duration
        sent = 0

        while time.time() < end_time:

            source.cmd(
                f"ping -c 1 -W 1 "
                f"{destination.IP()} > /dev/null 2>&1"
            )

            sent += 1

            if interval > 0:
                time.sleep(interval)

        return sent

    def run_phase(name, duration, interval):

        print("\n------------------------------------------------------------")
        print(f" PHASE : {name}")
        print(f" Durée : {duration}s")
        print(f" Intervalle : {interval}s")
        print("------------------------------------------------------------")

        threads = []

        for source, destination in flows:

            thread = threading.Thread(
                target=traffic_worker,
                args=(source, destination, duration, interval)
            )

            thread.start()
            threads.append(thread)

        for thread in threads:
            thread.join()

        print(f" FIN PHASE : {name}")

    # =========================================================
    # PHASE 1 : CHARGE NORMALE
    # =========================================================

    run_phase(
        "CHARGE NORMALE",
        duration=10,
        interval=0.20
    )

    # =========================================================
    # PHASE 2 : MONTEE EN CHARGE
    # =========================================================

    run_phase(
        "MONTEE EN CHARGE",
        duration=10,
        interval=0.05
    )

    # =========================================================
    # PHASE 3 : PIC DE SURCHARGE
    # =========================================================

    run_phase(
        "PIC DE SURCHARGE",
        duration=10,
        interval=0.01
    )

    # =========================================================
    # PHASE 4 : RETOUR PROGRESSIF
    # =========================================================

    run_phase(
        "RETOUR PROGRESSIF",
        duration=10,
        interval=0.05
    )

    # =========================================================
    # PHASE 5 : CHARGE NORMALE
    # =========================================================

    run_phase(
        "RETOUR A LA CHARGE NORMALE",
        duration=10,
        interval=0.20
    )

    print("\n============================================================")
    print(" FIN SCENARIO C - SURCHARGE TRANSITOIRE")
    print("============================================================\n")

def run_high_demand_test(net, duration=20, interval=0.05):
    """
    Génère de nombreuses demandes concurrentes entre les clients
    pendant une durée donnée.

    Objectif :
    augmenter le renouvellement des flux afin de provoquer
    davantage d'événements Packet-In.
    """

    import threading
    import time

    flows = [
        ("h1", "h7"), ("h1", "h8"),
        ("h2", "h9"), ("h2", "h10"),
        ("h3", "h11"), ("h3", "h12"),

        ("h4", "h7"), ("h4", "h9"),
        ("h5", "h8"), ("h5", "h10"),
        ("h6", "h11"), ("h6", "h12"),

        ("h7", "h1"), ("h7", "h3"),
        ("h8", "h2"), ("h8", "h4"),
        ("h9", "h5"), ("h9", "h6"),

        ("h10", "h1"), ("h10", "h2"),
        ("h11", "h3"), ("h11", "h4"),
        ("h12", "h5"), ("h12", "h6"),
    ]

    stop_event = threading.Event()
    total_requests = [0]
    lock = threading.Lock()

    def worker(src_name, dst_name):
        src = net.get(src_name)
        dst = net.get(dst_name)

        while not stop_event.is_set():
            src.cmd(
                f"ping -c 1 -W 1 {dst.IP()} "
                "> /dev/null 2>&1"
            )

            with lock:
                total_requests[0] += 1

            time.sleep(interval)

    threads = []

    print("\n========== HIGH DEMAND TEST ==========")
    print(f"Durée : {duration}s")
    print(f"Intervalle : {interval}s")
    print(f"Demandes concurrentes : {len(flows)}")

    for src, dst in flows:
        t = threading.Thread(
            target=worker,
            args=(src, dst),
            daemon=True
        )
        threads.append(t)
        t.start()

    time.sleep(duration)
    stop_event.set()

    for t in threads:
        t.join(timeout=2)

    print(f"Demandes générées : {total_requests[0]}")
    print(
        f"Débit approximatif : "
        f"{total_requests[0] / duration:.2f} demandes/s"
    )
    print("========== FIN HIGH DEMAND ==========\n")
