#!/usr/bin/env python3

from monitoring.controller_workload_monitor import (
    ControllerWorkloadMonitor
)

from monitoring.metric_normalizer import (
    MetricNormalizer
)

from monitoring.controller_clustering_edge import (
    ControllerClusteringEdge
)

from monitoring.ema import (
    ExponentialMovingAverage
)


class SchedulingLayer:

    def __init__(
        self,
        controllers,
        n_clusters=3,
        ema_alpha=0.3
    ):

        if not controllers:
            raise ValueError(
                "Aucun controleur fourni."
            )

        self.controllers = controllers

        self.monitor = ControllerWorkloadMonitor(
            controllers
        )

        self.normalizer = MetricNormalizer()

        self.ema = {
            controller: ExponentialMovingAverage(
                alpha=ema_alpha
            )
            for controller in controllers
        }

        self.clustering = ControllerClusteringEdge(
            n_clusters=n_clusters
        )

        self.last_result = None

    # ========================================================
    # RECUPERATION DES 5 METRIQUES
    # ========================================================

    def get_controller_metrics(self):

        workloads = self.monitor.get_all_workloads()

        metrics = {}

        for controller in self.controllers:

            workload = workloads.get(
                controller,
                {}
            )

            metrics[controller] = {
                "cpu": float(
                    workload.get("cpu", 0.0)
                ),

                "memory": float(
                    workload.get("memory", 0.0)
                ),

                "throughput": float(
                    workload.get("throughput", 0.0)
                ),

                "latency": float(
                    workload.get("latency", 0.0)
                ),

                "flows": float(
                    workload.get("flows", 0.0)
                )
            }

        return metrics

    # ========================================================
    # EMA
    # ========================================================

    def apply_ema(self, metrics):

        smoothed = {}

        for controller, values in metrics.items():

            smoothed[controller] = {}

            for metric, value in values.items():

                key = (
                    f"{controller}_{metric}"
                )

                if key not in self.ema:

                    self.ema[key] = (
                        ExponentialMovingAverage(
                            alpha=0.3
                        )
                    )

                smoothed[controller][metric] = (
                    self.ema[key].update(
                        key,
                        value
                    )
                )

        return smoothed

    # ========================================================
    # SCORE DE CHARGE
    # ========================================================

    def calculate_load_score(
        self,
        normalized_metrics
    ):

        scores = {}

        for controller, metrics in (
            normalized_metrics.items()
        ):

            values = [
                float(metrics["cpu"]),
                float(metrics["memory"]),
                float(metrics["throughput"]),
                float(metrics["latency"]),
                float(metrics["flows"])
            ]

            scores[controller] = (
                sum(values) / len(values)
            )

        return scores

    # ========================================================
    # DECISION
    # ========================================================

    def select_controller_from_result(
        self,
        result
    ):

        controllers = result["controllers"]

        if not controllers:
            return None

        scores = result.get(
            "scores",
            {}
        )

        states = result.get(
            "states",
            {}
        )

        # ----------------------------------------------------
        # Un seul controleur
        # ----------------------------------------------------

        if len(controllers) == 1:
            return controllers[0]

        # ----------------------------------------------------
        # Priorite a l'etat de charge
        # C1 < C2 < C3
        # ----------------------------------------------------

        state_rank = {
            "C1": 1,
            "C2": 2,
            "C3": 3
        }

        ranked = sorted(
            controllers,
            key=lambda controller: (
                state_rank.get(
                    states.get(controller, "C3"),
                    3
                ),
                scores.get(
                    controller,
                    float("inf")
                )
            )
        )

        return ranked[0]

    # ========================================================
    # SCHEDULING COMPLET
    # ========================================================

    def schedule(self):

        # 1. Mesure des cinq metriques
        raw_metrics = (
            self.get_controller_metrics()
        )

        # 2. Lissage EMA
        smoothed_metrics = (
            self.apply_ema(
                raw_metrics
            )
        )

        # 3. Normalisation
        normalized_metrics = (
            self.normalizer.transform(
                smoothed_metrics
            )
        )

        # 4. K-means++ K=3
        clustering = (
            self.clustering.cluster(
                normalized_metrics
            )
        )

        # ----------------------------------------------------
        # Historique insuffisant
        # ----------------------------------------------------

        if not clustering["ready"]:

            scores = (
                self.calculate_load_score(
                    normalized_metrics
                )
            )

            selected = min(
                scores,
                key=scores.get
            )

            result = {
                "raw_metrics":
                    raw_metrics,

                "smoothed_metrics":
                    smoothed_metrics,

                "normalized_metrics":
                    normalized_metrics,

                "scores":
                    scores,

                "clustering":
                    clustering,

                "selected_controller":
                    selected
            }

            self.last_result = result

            return result

        # ----------------------------------------------------
        # Classification + decision
        # ----------------------------------------------------

        selected = (
            self.select_controller_from_result(
                clustering
            )
        )

        result = {
            "raw_metrics":
                raw_metrics,

            "smoothed_metrics":
                smoothed_metrics,

            "normalized_metrics":
                normalized_metrics,

            "scores":
                clustering["scores"],

            "clustering":
                clustering,

            "selected_controller":
                selected
        }

        self.last_result = result

        return result
